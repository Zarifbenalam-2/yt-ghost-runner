__pycache__/
*.pyc
*.pyo
profiles/ghost_temp/
data/live_feed.json
data/*.tmp
data/*.tmp.json
ipshelf/data/
ipshelf/hunt/proxyhunt/
ipshelf/hunt/goldbank/
_hunt/
*.log
.env
accounts.json
autopilot_state.json

# ── runtime state & generated evidence (must NEVER be committed) ──
data/logs/
data/audit_evidence/
data/factory_seen.json
data/factory_gold_log.jsonl
data/factory_gold_shard_*.json
data/run_report_*.json
data/tunnel_url_*.txt
data/policy.json
data/*.db
data/*.db-journal
data/*.db-wal

# The dashboard reads a PAT from here when the git credential store has none
# (server.resolve_github_token). Its docstring claimed this path was ignored,
# but .gitignore never listed it — a single `git add -A` would have committed
# the operator's PAT.
data/.gh_token
.gh_token

# Durable secret store read by server.resolve_github_token as the LAST fallback
# and by any ZCode session that needs credentials. NEVER commit.
data/secrets.json
data/secrets.json.tmp

# NOTE: data/ip_pool_snapshot.json IS intentionally tracked — cloud runners
# bootstrap their shelf from it (load_pool_snapshot.py).
.zcode/
